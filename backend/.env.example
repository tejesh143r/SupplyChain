# SecureChainFlow Backend Environment Configuration

# Server Port
PORT=5000

# Blockchain RPC Provider URL (Hardhat Local / Polygon Amoy)
RPC_URL=http://127.0.0.1:8545

# Deployer / Relayer Wallet Private Key
PRIVATE_KEY=replace_with_a_real_relayer_private_key

# Pinata IPFS Decentralized Storage API Credentials (Optional)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt_token

# Python FastAPI AI Microservice URL
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=replace_with_a_long_random_service_key

# Comma-separated browser origins allowed to call the backend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional API protection. Set this in production and send x-api-key or Bearer credentials.
API_KEY=replace_with_a_long_random_client_key

# Keep true for local development only. Production should use Pinata credentials instead.
IPFS_FALLBACK_ENABLED=true
